# Public configuration
NUXT_PUBLIC_SITE_URL=https://ideawinemaker.ru
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=

# SQLite. Use an absolute path in production.
NUXT_DATABASE_PATH=.data/ideawinemaker.sqlite
DATABASE_BACKUP_DIR=.data/backups

# Single administrator. Generate the hash with nuxt-auth-utils hashPassword.
NUXT_ADMIN_LOGIN=admin
# Keep scrypt hashes in single quotes so every `$` is preserved.
NUXT_ADMIN_PASSWORD_HASH=''

# At least 32 characters. Keep this stable or active sessions will be invalidated.
NUXT_SESSION_PASSWORD=replace-with-a-long-random-secret-at-least-32-characters
