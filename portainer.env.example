# Add these variables in Portainer under Stack > Environment variables.
# Do not commit real secrets to this file.

APP_PORT=8020
NUXT_PUBLIC_SITE_URL=https://ideawinemaker.ru
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=
RUN_DB_SEED=true

NUXT_ADMIN_LOGIN=admin
# Portainer/Compose consumes one $ escaping level: enter every $ as $$.
# Example shape only; replace it with your generated scrypt hash.
NUXT_ADMIN_PASSWORD_HASH=$$scrypt$$n=16384,r=8,p=1$$SALT$$HASH

# Use a production-only random value of at least 32 characters and keep it stable.
NUXT_SESSION_PASSWORD=replace-with-a-production-random-secret-at-least-32-characters
